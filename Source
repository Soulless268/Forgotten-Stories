    enableBM = not enableBM
    FullBrightMapButton.BackgroundColor3 = if enableBM then truecolor else falsecolor
    
    local function bright()
        local tile_name = workspace.WorldInfo.Tile.Value
        local biome = workspace.WorldInfo.CurrentBiome.Value
        local current_tile
        if biome == "Caves" or biome == "CrystalRift" then
            current_tile = workspace.WorldMap:FindFirstChild(`Cave_{tile_name}`)
        else
            current_tile = workspace.WorldMap:FindFirstChild(tile_name)
        end
        if not current_tile then return end
        sl.Parent = current_tile:FindFirstChild("Base") or current_tile
    end

    if enableBM then
        bright()
        runners.runner_BM = workspace.WorldInfo.Tile:GetPropertyChangedSignal("Value"):Connect(function()
            bright()
        end)
        runners.runner_BM_2 = workspace.WorldInfo.CurrentBiome:GetPropertyChangedSignal("Value"):Connect(function()
            bright()
        end)
    else
        if runners.runner_BM then runners.runner_BM:Disconnect() end
        if runners.runner_BM_2 then runners.runner_BM_2:Disconnect() end
        sl.Parent = nil
    end
end)

