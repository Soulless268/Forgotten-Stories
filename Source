local function showUnlockedLibaryRequire()
    local path = plr.PlayerGui.LibraryStats.SkillLibrary.UnlockedShelf.ScrollingFrame

    if not showLibrary then
        if isMainLobby then
            for _,v in path:GetChildren() do
                if runners[`HoverEnter_{v.Name}`] then runners[`HoverEnter_{v.Name}`]:Disconnect() end
                if runners[`HoverLeave_{v.Name}`] then runners[`HoverLeave_{v.Name}`]:Disconnect() end
                if not v:GetAttribute("Locked") then continue end
                if v:FindFirstChild("Written") then v:FindFirstChild("Written").Image = "rbxassetid://129898648862943" end
                if v:FindFirstChild("Written") then v:FindFirstChild("Written").ImageColor3 = Color3.fromRGB(255,255,255) end
            end
        else
            for _,v in path:GetChildren() do
                if string.sub(v.Name, -7) == "_Holder" then v:Destroy() end
                if runners[`HoverEnter_{v.Name}`] then runners[`HoverEnter_{v.Name}`]:Disconnect() end
                if runners[`HoverLeave_{v.Name}`] then runners[`HoverLeave_{v.Name}`]:Disconnect() end
            end
        end
        return
    end

    if not isMainLobby then
        for name,v in pairs(libraryModule) do
            if path:FindFirstChild(`{name}_Holder`) then path:FindFirstChild(`{name}_Holder`):Destroy() end
            if path:FindFirstChild(name) then continue end
            if not rp.PreMades.Books:FindFirstChild(name) then continue end
            local book_image = v.Illustration --v.ImageId in AchievementLibrary Module
            local requirements_text = if achievementLibraryModule[name] then achievementLibraryModule[name].Text else nil
            local requirements = v.Requirements
            local auto_progress = v.AutoProgress

            local remain_requirements = table.clone(requirements)
            if auto_progress then
                for i,vv in pairs(auto_progress) do
                    remain_requirements[i] -= vv
                    if remain_requirements[i] == 0 then remain_requirements[i] = nil end
                end
                if not next(remain_requirements) then remain_requirements = nil end
            else
                remain_requirements = "Unlocked on spawn"
            end

            local function formatRequirements(tabl)
                if typeof(tabl) == "string" then return tabl end
                local parts = {}
                for i, amount in pairs(tabl) do
                    table.insert(parts, `{i} = {amount}`)
                end
                return table.concat(parts, ", ")
            end

            local clone = rp.PreMades.Books[name]:Clone()
            clone.Name = `{name}_Holder`
            clone.LayoutOrder = 1
            clone.HoverImage = book_image
            clone.Image = book_image
            clone.ImageColor3 = Color3.fromRGB(100,100,100)
            clone.Visible = true
            clone.Parent = path

            if name == "True Strength" and not requirements_text then
                requirements_text = achievementLibraryModule["True Strenght"].Text
            end

            if not requirements_text then logs(`{name} dont have table. or is it error?`, true) end

            runners[`HoverEnter_{name}`] = clone.MouseEnter:Connect(function()
                HoverFrame:FindFirstChild("Title").Text = name
                HoverFrame:FindFirstChild("Text1").Text = `Requirements: {formatRequirements(requirements_text or requirements)}`
                HoverFrame:FindFirstChild("Text2").Text = `Unlocked Requirements: {formatRequirements(remain_requirements)}`

                HoverFrame.Visible = true
                logs("Button is being hovered!")
            end)

            runners[`HoverLeave_{name}`] = clone.MouseLeave:Connect(function()
                HoverFrame.Visible = false
                logs("Mouse left the button.")
            end)
        end
    else
        for name,v in pairs(libraryModule) do
            if not path:FindFirstChild(name) then continue end
            if path:FindFirstChild(name).Written.Image ~= "rbxassetid://129898648862943" and not path:FindFirstChild(name):GetAttribute("Locked") then continue end
            path:FindFirstChild(name):SetAttribute("Locked", true)

            local book_image = v.Illustration

            local function formatRequirements(tabl)
                if typeof(tabl) == "string" then return tabl end
                local parts = {}
                for i, amount in pairs(tabl) do
                    table.insert(parts, `{i} = {amount}`)
                end
                return table.concat(parts, ", ")
            end

            local button = path:FindFirstChild(name)
            button.Written.Image = book_image
            button.Visible = true
            button.Written.ImageColor3 = Color3.fromRGB(100,100,100)

            runners[`HoverEnter_{name}`] = button.MouseEnter:Connect(function()
                if not HoverFrame:FindFirstChild("Title") then return end
                if not HoverFrame:FindFirstChild("Text1") then return end
                HoverFrame:FindFirstChild("Title").Text = name
                HoverFrame:FindFirstChild("Text1").Size = UDim2.new(1,0,1,0)
                HoverFrame:FindFirstChild("Text1").Text = `Requirements: Error information Module not exist`
                HoverFrame.Visible = true
            end)

            runners[`HoverLeave_{name}`] = button.MouseLeave:Connect(function()
                HoverFrame.Visible = false
            end)
        end
    end
end

