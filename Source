local jsonAttempts = 0
local function load_setting()

    if not isfolder("NickHub") then
        makefolder("NickHub")
    end

    if not isfile(file_path) then
        writefile(file_path, "")
    end

	local readSuccess = readfile(file_path, true)
	if readSuccess then
        logs(`Load sucess: {readSuccess}`)
		if readSuccess ~= nil and tostring(readSuccess):gsub("%s", "") ~= "" then
			local success, response = pcall(function()
				local json = HttpService:JSONDecode(readSuccess)
				for key, defaultValue in pairs(configs) do
					local value = json[key]
					if value == defaultValue then
                        logs(`UnChange | {key} | {value} | {typeof(value)}`)
                        configs[key] = defaultValue
                    elseif value == nil and defaultValue ~= nil then
                        logs(`Table not exist | {key} | {value} | {typeof(value)}`)
                        continue
					else
                        logs(`Change | {key} | {value} | {typeof(value)}`)
                        configs[key] = value
					end
				end
			end)
			if not success then
				jsonAttempts = jsonAttempts + 1
				warn("Save Json Error:", response)
				warn("Overwriting Save File")
				writefile(file_path, defaults, true)
				task.wait(1)
				local dReadSuccess = readfile(file_path, true)
				if dReadSuccess ~= nil and tostring(dReadSuccess):gsub("%s", "") ~= "" then
					load_setting()
				end
			end
		end
	else
		writefile(file_path, defaults, true)
		task.wait(1)
		local dReadSuccess = readfile(file_path, true)
		if dReadSuccess ~= nil and tostring(dReadSuccess):gsub("%s", "") ~= "" then
			load_setting()
		end
	end

end

