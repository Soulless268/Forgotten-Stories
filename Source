runners.runner_spellRunes = plr.PlayerGui:WaitForChild("PlayerGui").ChildAdded:Connect(function(child)
    if not enable then return end
    if child.Name ~= "Runesight" then return end

    makeSpellButton()

    if not next(selectedSpell) then
        repeat task.wait() until next(selectedSpell) or not child:IsDescendantOf(plr.PlayerGui)
        -- selectedSpell = unlockedSpells[math.random(1, #unlockedSpells)]
        if not child:IsDescendantOf(plr.PlayerGui) then return end
    end

    local lists = {}
    local howMany = 0

    for _,v in pairs(child.RuneList:GetChildren()) do
        if not v:IsA("ImageLabel") then continue end
        howMany += 1
    end

    local function insert_spell(name, amount)
        for i = 1,amount do
            table.insert(lists, name)
            howMany -= 1
        end
    end

    if spellsModule[selectedSpell.Name] then
        local spell = spellsModule[selectedSpell.Name]

        if spell.Fire then
            insert_spell("Fire", spell.Fire)
        end

        if spell.Water then
            insert_spell("Water", spell.Water)
        end

        if spell.Wind then
            insert_spell("Wind", spell.Wind)
        end

        if spell.Earth then
            insert_spell("Earth", spell.Earth)
        end

        if spell.Chaos then
            insert_spell("Chaos", spell.Chaos)
        end

        if spell.Void then
            insert_spell("Void", spell.Void)
        end

        if spell.Order then
            insert_spell("Order", spell.Order)
        end
    end

    if howMany ~= 0 and selectedSpell.isMax then
        if howMany > spellsModule[selectedSpell.Name].MaxIncrease then
            insert_spell(spellsModule[selectedSpell.Name].Increase, spellsModule[selectedSpell.Name].MaxIncrease)
        else
            insert_spell(spellsModule[selectedSpell.Name].Increase, howMany)
        end
        howMany = 0
    end

    for _,rune_name in pairs(lists) do
        local button = child.RuneInCircle:FindFirstChild(rune_name.."RuneButton")
        if button then
            autoClickImage(button)
        end
        task.wait(.5)
    end

    if not child:IsDescendantOf(plr.PlayerGui) then return end
    if not next(lists) then return end
    autoClickImage(child.CastButton)

end)

