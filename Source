    local animator = humanoid:WaitForChild("Animator", 2)

    if not humanoid then return end
    
    local target_name = {
        Hit = "F";
        Parry = "F";
        Left = "A";
        Right = "D";
        Jump = "Space";
        Down = "S";
    }

    animationTracked[model] = animator.AnimationPlayed:Connect(function(track)
        local animation = track.Animation
        logs(`Animation started!`)
        logs(`Track Name: {animation.Name}`, true)
        logs(`Track ID: {animation.AnimationId}`, true)

        local sequence = game:GetService("KeyframeSequenceProvider"):GetKeyframeSequenceAsync(animation.AnimationId)
        local current_have = {}

        for _, keyframe in ipairs(sequence:GetKeyframes()) do
            for _, marker in ipairs(keyframe:GetMarkers()) do
                local markerName = marker.Name
                if target_name[markerName] then current_have[markerName] = true else continue end

                if not animationTracked[track] then
                    animationTracked[track] = track:GetMarkerReachedSignal(markerName):Connect(function(value)
                        logs(`Marker detected: {markerName} | Value: {value}`, true)

                        if configs.dodgeType == "AnimationTrack" then

                        end

                    end)
                end
            end
        end
    end)
end

