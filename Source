local function makeSpellButton()
    for _,v in pairs(plr.PlayerGui.LibraryStats.SkillLibrary.CoreStats.SpellsButton.Background.ScrollingFrame:GetChildren()) do
        if not v:IsA("Frame") then continue end
        if table.find(unlockedSpells, v.Name) then continue end
        table.insert(unlockedSpells, v.Name)
    end

    for _,name in pairs(unlockedSpells) do
        if spells_frame:FindFirstChildOfClass("ScrollingFrame"):FindFirstChild(name) then continue end
        local clone = plr.PlayerGui.LibraryStats.SkillLibrary.CoreStats.SpellsButton.Background.ScrollingFrame:FindFirstChild(name):Clone()
        clone.Name = name
        clone.BorderMode = "Inset"
        clone.Tittle.BorderMode = "Inset"
        clone.Description.TextScaled = true
        clone.EmpowerRune.Tittle.BackgroundTransparency = 1

        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, 0, 1, 0)
        button.BackgroundTransparency = 1
		button.Parent = clone

        clone.Parent = spells_frame:FindFirstChildOfClass("ScrollingFrame")

        local maxRuneButton = Instance.new("TextButton")
        maxRuneButton.BackgroundColor3 = Color3.fromRGB(0,0,0)
        maxRuneButton.AnchorPoint = Vector2.new(1, 1)
        maxRuneButton.Text = "Max"
        maxRuneButton.Name = "MaxRune"
        maxRuneButton.TextScaled = true
        maxRuneButton.Size = UDim2.new(.2, 0, .15, 0)
        maxRuneButton.Position = UDim2.new(1, 0, 1, 0)
		maxRuneButton.Parent = clone

        maxRuneButton.Activated:Connect(function()
            if not next(selectedSpell) then return end
            if selectedSpell.Name ~= name then return end

            selectedSpell.isMax = not selectedSpell.isMax
            maxRuneButton.BackgroundColor3 = if selectedSpell.isMax then truecolor else Color3.fromRGB(0,0,0)

        end)

        button.Activated:Connect(function()
            if next(selectedSpell) then
                spells_frame:FindFirstChildOfClass("ScrollingFrame"):FindFirstChild(selectedSpell.Name).BorderColor3 = falsecolor
                spells_frame:FindFirstChildOfClass("ScrollingFrame"):FindFirstChild(selectedSpell.Name).MaxRune.BackgroundColor3 = Color3.fromRGB(0,0,0)
            end
            if selectedSpell.Name == name then
                selectedSpell = {}
                return
            end
            selectedSpell = {Name = name, isMax = false}
            spells_frame:FindFirstChildOfClass("ScrollingFrame"):FindFirstChild(selectedSpell.Name).BorderColor3 = truecolor
        end)
    end

end

