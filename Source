local function isMouseNearImage(obj, tolerance, pos)
	local mousePos = if not pos then uis:GetMouseLocation() else pos
    tolerance = tolerance or 30

	local imagePos = obj.AbsolutePosition
	local imageSize = obj.AbsoluteSize

	-- Expand the image's area by the tolerance
	local left = imagePos.X - tolerance
	local right = imagePos.X + imageSize.X + tolerance
	local top = imagePos.Y - tolerance
	local bottom = imagePos.Y + imageSize.Y + tolerance

	return mousePos.X >= left
		and mousePos.X <= right
		and mousePos.Y >= top
		and mousePos.Y <= bottom
end

local function isMouseInImage(obj, maxDistance)
	local mousePos = uis:GetMouseLocation()
    maxDistance = maxDistance or (if obj.AbsoluteSize.X == obj.AbsoluteSize.Y then obj.AbsoluteSize.X else nil) or 50

	local center = obj.AbsolutePosition + obj.AbsoluteSize / 2

	local distance = (Vector2.new(mousePos.X, mousePos.Y) - center).Magnitude

	return distance <= maxDistance
end

