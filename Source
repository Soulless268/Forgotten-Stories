runners.runner_dodgeArrow = plr.PlayerGui:WaitForChild("PlayerGui"):FindFirstChild("Visuals"):GetPropertyChangedSignal("Visible"):Connect(function()
    if not enable then return end
    if not plr.PlayerGui.PlayerGui.Visuals.Visible then return end

    local target_color_green = Color3.fromRGB(81, 237, 26)
    local target_color_red = Color3.fromRGB(140, 30, 30)
    
    for _,v in pairs(plr.PlayerGui.PlayerGui.Visuals:GetChildren()) do
        if dodgeAssignments[v] then continue end
        local isgreen = false
        local isred = true
        dodgeAssignments[v] = v:GetPropertyChangedSignal("ImageColor3"):Connect(function()
            if not enable then return end
            if pressing then return end

            local daze_stat = plr.PlayerGui.PlayerGui.StatBar.Statuses.Daze
            local is_daze = daze_stat.Visible
            local dodge_timing = if is_daze then .25 else .15

            local current = v.ImageColor3
            local distance_from_green = math.sqrt(
                (current.R - target_color_green.R)^2 +
                (current.G - target_color_green.G)^2 +
                (current.B - target_color_green.B)^2
            )

            local distance_from_red = math.sqrt(
                (current.R - target_color_red.R)^2 +
                (current.G - target_color_red.G)^2 +
                (current.B - target_color_red.B)^2
            )

            if distance_from_green < dodge_timing and not isgreen and isred then
                isred = false
                isgreen = true
                pressing = true
                key = v.TextLabel.Text
                print("Dodge!", key)
                vim:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                task.wait(.05)
                vim:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                pressing = false
            elseif distance_from_red < .3 and not isred and isgreen then
                isred = true
                isgreen = false
            end
        end)
    end

end)

