        if child.Name ~= "SoulkillerHearts" then return end
        
        local goods = {
            "Im breaking but im still here...";
            "Theres still something left in me...";
            "I know who I am.";
            "Its not the end yet...";
            "I must ignore those voices...";
            "Im so tired but I cant give in...";
        }

        repeat
            for _,v in pairs(plr.PlayerGui.PlayerGui:GetChildren()) do
                if not v:IsA("TextLabel") then continue end
                local text = v.Text
                if table.find(goods, text) then
                    press_key("Space")
                else
                    continue
                end
            end
            task.wait(1)
        until not child:IsDescendantOf(plr.PlayerGui) or not enable

    end)

    runners.runner_mining = plr.PlayerGui:WaitForChild("PlayerGui").ChildAdded:Connect(function(child)
        if not enable then return end

        if child.Name ~= "RockminigameQTE" then return end
        local CountdownLabel = child:WaitForChild("CountdownLabel")

        repeat task.wait() until not CountdownLabel:IsDescendantOf(child) or CountdownLabel.Text == "MINE!"
        task.wait(.1)
        repeat task.wait() until CountdownLabel.TextTransparency == 1

        local rocks = {}
        local break_rocks = {}

        logs("Start mining!")

        local function checkStone(obj)
            if obj.Image == "rbxassetid://85970625997038" then --break
                autoClickImage(obj)
                task.wait(.25)
            elseif obj.Image == "rbxassetid://112215877321999" then --rocks
                autoClickImage(obj)
                task.wait(.25)
            end
        end

        repeat
            for _,v in pairs(child:WaitForChild("Frame"):GetChildren()) do
                if not enable then break end
                if not child:IsDescendantOf(plr.PlayerGui) then break end
                if not v:IsA("ImageLabel") then continue end
                if v:GetAttribute("IsEmpty") == true then continue end

                if v.Image == "rbxassetid://85970625997038" then --break
                    rocks[v] = 1
                elseif v.Image == "rbxassetid://112215877321999" then --rocks
                    rocks[v] = 2
                else
                    if rocks[v] then rocks[v] = nil end
                end
            end

            table.sort(rocks, function(a,b) return a < b end)

            for i,v in pairs(rocks) do
                if not child:IsDescendantOf(plr.PlayerGui) or not enable then break end
                checkStone(i)
                checkStone(i)
            end

            task.wait()
        until not child:IsDescendantOf(plr.PlayerGui)

    end)
end

